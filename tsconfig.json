{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node runs these files by stripping the types, never by compiling them,
    // so nothing here may need a transform to run: no enums, no namespaces,
    // no parameter properties. This makes tsc reject that syntax outright
    // rather than letting it through to fail at runtime.
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/**/*.ts", "__tests__/**/*.ts"]
}
